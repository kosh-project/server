# ==============================================================================
# Kosh Server - Docker Compose Environment Configuration
# ==============================================================================
# Copy this file to '.env' before running 'docker compose up -d':
#   cp .env.example .env
# ==============================================================================

# Host directory where persistent vault data is stored.
# Contains: SQLite metadata database, TLS certificates, master secret, and BLAKE3 asset blobs.
# Defaults to './vault' in the current working directory.
# Example: KOSH_VAULT_PATH=/mnt/storage/kosh/vault
KOSH_VAULT_PATH=./vault

# Host path to the KDL configuration file.
# Defaults to './config/config.kdl'.
# For system-wide configs on Linux, you can point this to '~/.config/kosh/config.kdl' or '/etc/kosh/config.kdl'.
# Example: KOSH_CONFIG_PATH=~/.config/kosh/config.kdl
KOSH_CONFIG_PATH=./config/config.kdl

# Host directory where the admin UNIX domain socket is exposed.
# Enables running 'kosh-cli' on the host machine to attach to the container's live telemetry stream.
# Defaults to './run' in the current working directory.
# Example: KOSH_RUN_PATH=/var/run/kosh
KOSH_RUN_PATH=./run

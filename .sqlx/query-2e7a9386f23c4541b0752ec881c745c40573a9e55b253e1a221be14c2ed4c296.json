  "db_name": "SQLite",
  "query": "\n                SELECT\n                    id as \"id!\",\n                    hash,\n                    size_bytes,\n                    last_modified,\n                    tag as \"tag: Tag\"\n                FROM assets\n                WHERE user_id = ?1\n                    AND tag = ?2\n                    AND (\n                        ?3 IS NULL\n                        OR last_modified < ?3\n                        OR (last_modified = ?3 AND id < ?4)\n                    )\n                ORDER BY last_modified DESC, id DESC\n                LIMIT ?5\n                ",
